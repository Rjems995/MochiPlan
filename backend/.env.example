HOST=127.0.0.1
PORT=3001
# Number of distinct backup versions kept per browser workspace (1-100).
BACKUP_HISTORY_LIMIT=30
# Required for background reminders: use your real contact email or public HTTPS URL.
# The server generates and reuses private signing keys in backend/data/push-keys.json.
# VAPID_SUBJECT=mailto:you@example.com
# Optional: supply a persistent key path or an existing matching key pair.
# VAPID_KEY_PATH=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional absolute paths. Defaults are backend/data/mochiplan.sqlite and frontend/dist.
# DATABASE_PATH=
# FRONTEND_DIST=
# Optional comma-separated browser origins, in addition to local development origins.
# ALLOWED_ORIGINS=https://your-own-domain.example
